# Public base URL of this app. Instagram downloads media from here, and OAuth
# redirect URIs are built from it, so in production it must be reachable from the internet over HTTPS.
PUBLIC_URL=http://localhost:3000

# Login password for the app (single user).
APP_PASSWORD=change-me

# 32+ random characters. Signs sessions and encrypts stored OAuth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Where the SQLite database and uploaded media live. Must be persistent storage.
DATA_DIR=./data

# Uploaded files are deleted once every post using them has published (or been handed
# to YouTube's own scheduler). Set to true to keep them.
KEEP_PUBLISHED_MEDIA=false

# Disk budget for DATA_DIR in GB (Railway Hobby volumes are 5 GB). The app warns at
# STORAGE_WARN_PERCENT and refuses uploads that would leave less than 2% (max 100 MB) free.
STORAGE_LIMIT_GB=5
STORAGE_WARN_PERCENT=80

# Max upload size in MB.
MAX_UPLOAD_MB=2048

# Instagram API with Instagram Login (Meta app -> Instagram -> API setup with Instagram login)
# Redirect URI to register: ${PUBLIC_URL}/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# Google Cloud OAuth client (Web application) with YouTube Data API v3 enabled
# Redirect URI to register: ${PUBLIC_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Simulated Instagram/YouTube accounts that "publish" without calling any API. For trying the app.
ENABLE_DEMO_ACCOUNTS=false

# Optional: lets an external cron hit GET /api/cron with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
